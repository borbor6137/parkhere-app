# parkhere-api (ค่าไม่ลับเท่านั้น ห้ามใส่ TB_API_KEY จริงในไฟล์นี้)
TB_HOST=https://eu.thingsboard.cloud
TB_SENSOR_DEVICE_ID=c7749ae0-e268-11f1-abc4-373280129aee
TB_ASSET_ID=026716f0-e269-11f1-abc4-373280129aee
TB_CUSTOMER_MEMBERS_ID=2029cd90-e269-11f1-abc4-373280129aee
TB_CUSTOMER_STAFF_ID=209894f0-e269-11f1-abc4-373280129aee
WEB_ORIGINS=https://<ชื่อเว็บบน-render>.onrender.com
# TB_API_KEY=  <- ตั้งใน Render Environment เท่านั้น
# SESSION_SECRET ไม่ต้องใช้ใน M1 (ใช้ JWT ของ ThingsBoard)
# M2 (ไม่บังคับ) อุปกรณ์ที่ส่งสถานะช่องมากกว่า 1 ตัว: ParkHere-Sim (Wokwi) ยังไม่ได้สร้าง ไม่ตั้งก็ได้
# TB_SIM_DEVICE_ID=
# TB_SENSOR_DEVICE_IDS=   # รายการ id คั่นจุลภาค (ไม่บังคับ)
# ALLOW_LOCALHOST=0    # ปิด localhost ใน CORS บน production
# LIVE_POLL_MS=1000  LOT_ATTR_MS=5000  LOT_CACHE_MS=2000  LIVE_MAX_PER_USER=3  LIVE_MAX_TOTAL=100  LIVE_PING_MS=20000
# อีเมลสำหรับ api/test/live.js (สมัคร/forgot) ตั้งในไฟล์ .env ของเครื่องตัวเองเท่านั้น
PROBE_EMAIL=
